{
  "name": "@tigrisdata/tigris-mcp-server",
  "version": "1.14.1",
  "description": "MCP server for Tigris Data.",
  "main": "dist/index.js",
  "type": "module",
  "author": "Tigris Data",
  "homepage": "https://tigrisdata.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tigrisdata/tigris-mcp-server.git"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "server",
    "typescript",
    "s3",
    "tigris"
  ],
  "bin": {
    "tigris-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "biome check src",
    "format": "biome format --write src",
    "changeset": "changeset",
    "release": "changeset publish",
    "lint:fix": "biome check --write src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.777.0",
    "@aws-sdk/credential-providers": "^3.778.0",
    "@aws-sdk/s3-request-presigner": "^3.782.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "inquirer": "^12.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.13.14",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
